#include <stdio.h>

int main() {
    int var = 10;
    int *ptr;
    ptr = &var;

    printf("Value of var: %d\n", var);
    printf("Address of var: %p\n", &var);
    printf("Value of var using pointer: %d\n", *ptr);
    printf("Address stored in pointer: %p\n", ptr);

    *ptr = 20;

    printf("Updated value of var: %d\n", var);

    return 0;
}
