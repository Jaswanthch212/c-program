#include <stdio.h>

int main() {
    int var = 10;
    int *ptr;
    ptr = &var;
    printf("Value of var: %d\n", var);
    printf("Address of var: %p\n", &var);
    printf("Value of pointer ptr: %p\n", ptr);
    printf("Value at the address pointed to by ptr: %d\n", *ptr);
    *ptr = 20;
    printf("New value of var: %d\n", var);
    return 0;
}

