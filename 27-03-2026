#include <stdio.h>

int main() {
    int n, i;
    scanf("%d", &n);

    int a[n];
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    int maxSum = 0;
    for (i = 0; i < 3; i++)
        maxSum += a[i];

    int currentSum = maxSum;

    for (i = 3; i < n; i++) {
        currentSum = currentSum - a[i - 3] + a[i];
        if (currentSum > maxSum)
            maxSum = currentSum;
    }

    printf("%d", maxSum);
    return 0;
}
