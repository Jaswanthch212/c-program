#include <stdio.h>
int main(){
    int n,i,key,a[100],flag=0;
    scanf("%d",&n);
    for(i=0;i<n;i++) scanf("%d",&a[i]);
    scanf("%d",&key);
    for(i=0;i<n;i++){
        if(a[i]==key){
            flag=1;
            break;
        }
    }
    if(flag) printf("Found");
    else printf("Not Found");
}
