#include <stdio.h>

int main()
{
    int n,i,first=1;

    scanf("%d",&n);

    for(i=2;i<=n;i++)
    {
        if(n%i==0)
        {
            int j,flag=1;
            for(j=2;j<i;j++)
                if(i%j==0)
                    flag=0;

            if(flag)
            {
                if(!first) printf(" ");
                printf("%d",i);
                first=0;
            }
        }
    }

    return 0;
}
