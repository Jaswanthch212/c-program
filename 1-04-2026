#include <stdio.h>
int main(){
    int n,i,a[100],max,sec;
    scanf("%d",&n);
    for(i=0;i<n;i++) scanf("%d",&a[i]);
    max=sec=-9999;
    for(i=0;i<n;i++){
        if(a[i]>max){
            sec=max;
            max=a[i];
        } else if(a[i]>sec && a[i]!=max){
            sec=a[i];
        }
    }
    printf("%d",sec);
}
