#include <stdio.h>

int main()
{
    int n,i;

    scanf("%d",&n);

    for(i=2;i<=n;i++)
    {
        if(n%i==0)
        {
            int j,flag=1;

            for(j=2;j<i;j++)
                if(i%j==0)
                    flag=0;

            if(flag)
                printf("%d ",i);
        }
    }

    return 0;
}
